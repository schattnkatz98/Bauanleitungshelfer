<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Bauplan Manager"
        Height="500"
        Width="995"
        MinHeight="450"
        MinWidth="850"
        Icon="/Assets/dragon.png"
        Background="#0f172b">

    <Window.Resources>

        <!-- Sidebar Button Style -->
        <Style x:Key="SidebarButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="0"
                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#1F2937"/>
                                <Setter Property="Foreground"
                                        Value="White"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#7C3AED"/>
                                <Setter Property="Foreground"
                                        Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <!-- Custom Scrollbar -->
        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="8"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid Background="Transparent"
                              Width="{TemplateBinding Width}"
                              HorizontalAlignment="Center">

                            <Track x:Name="PART_Track"
                                   IsDirectionReversed="True">

                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Border Width="6"
                                                        Background="#7C3AED"
                                                        CornerRadius="4"
                                                        HorizontalAlignment="Center"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>

                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <!-- Recipe / Item Card Style -->
        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Width" Value="210"/>
            <Setter Property="MinHeight" Value="160"/>
            <Setter Property="Margin" Value="0,0,15,15"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Background" Value="GhostWhite"/>
            <Setter Property="BorderBrush" Value="#8e51ff"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
        </Style>


        <!-- Profile Stat Card Styles -->
        <Style x:Key="StatCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#111827"/>
            <Setter Property="BorderBrush" Value="#8e51ff"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0,0,15,0"/>
        </Style>

        <Style x:Key="StatLabelTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#A78BFA"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="StatValueTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,10,0,0"/>
        </Style>

        <Style x:Key="StatSubTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#D1D5DB"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>


        <!-- Item Card Template -->
        <DataTemplate x:Key="ItemCardTemplate">
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock Text="{Binding Name}"
                               FontSize="20"
                               FontWeight="Bold"
                               TextWrapping="Wrap"/>

                    <TextBlock Text="Bauteil-Info:"
                               FontSize="14"
                               FontWeight="Bold"
                               Margin="0,18,0,8"/>

                    <TextBlock Text="{Binding Info}"
                               FontSize="13"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </DataTemplate>


        <!-- Recipe Card Template -->
        <DataTemplate x:Key="RecipeCardTemplate">
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock Text="{Binding Name}"
                               FontSize="20"
                               FontWeight="Bold"
                               TextWrapping="Wrap"/>

                    <TextBlock Text="Benötigte Materialien:"
                               FontSize="14"
                               FontWeight="Bold"
                               Margin="0,18,0,8"/>

                    <TextBlock Text="{Binding Materials}"
                               FontSize="13"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </DataTemplate>

    </Window.Resources>


    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>


        <!-- Sidebar -->
        <Border Grid.Column="0"
                Background="#111827"
                Padding="0">

            <StackPanel>
                <StackPanel Orientation="Horizontal"
                            Margin="0,0,0,25"/>

                <!-- Profil -->
                <Button Tag="Profil"
                        Style="{StaticResource SidebarButtonStyle}"
                        Click="SidebarButton_Click">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="55"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Image Grid.Column="0"
                               Source="/Assets/user.png"
                               Width="20"
                               Height="20"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>

                        <TextBlock Grid.Column="1"
                                   Text="Profil"
                                   FontSize="14"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Button>


                <!-- Bauteile -->
                <Button Tag="Bauteile"
                        Style="{StaticResource SidebarButtonStyle}"
                        Click="SidebarButton_Click">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="55"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Image Grid.Column="0"
                               Source="/Assets/book-open.png"
                               Width="20"
                               Height="20"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>

                        <TextBlock Grid.Column="1"
                                   Text="Bauteile"
                                   FontSize="14"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Button>


                <!-- Anleitungen -->
                <Button Tag="Anleitungen"
                        Style="{StaticResource SidebarButtonStyle}"
                        Click="SidebarButton_Click">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="55"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Image Grid.Column="0"
                               Source="/Assets/puzzle.png"
                               Width="20"
                               Height="20"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>

                        <TextBlock Grid.Column="1"
                                   Text="Anleitungen"
                                   FontSize="14"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Button>


                <!-- Einstellungen -->
                <Button Tag="Einstellungen"
                        Style="{StaticResource SidebarButtonStyle}"
                        Click="SidebarButton_Click">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="55"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Image Grid.Column="0"
                               Source="/Assets/settings.png"
                               Width="20"
                               Height="20"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>

                        <TextBlock Grid.Column="1"
                                   Text="Einstellungen"
                                   FontSize="14"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Button>
            </StackPanel>
        </Border>


        <!-- Anleitungen View -->
        <Grid x:Name="AnleitungenView"
              Grid.Column="1"
              Visibility="Collapsed"
              d:Visibility="Collapsed"
              Margin="25">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Height="40"
                    Margin="0,0,0,15"
                    Background="GhostWhite"
                    BorderBrush="#8e51ff"
                    BorderThickness="1"
                    CornerRadius="10">

                <TextBox x:Name="SearchBox"
                         FontSize="14"
                         Padding="10,0"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="Black"
                         CaretBrush="Black"
                         VerticalContentAlignment="Center"
                         KeyDown="SearchBox_KeyDown"/>
            </Border>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">

                <ItemsControl x:Name="RecipeCardsControl"
                              ItemTemplate="{StaticResource RecipeCardTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>
        </Grid>


        <!-- Profil View -->
        <Grid x:Name="ProfilView"
              Grid.Column="1"
              Visibility="Visible"
              d:Visibility="Visible"
              Margin="25">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="User Stats"
                       Foreground="White"
                       FontSize="24"
                       FontWeight="Bold"
                       Margin="0,0,0,20"/>

            <UniformGrid Grid.Row="1"
                         Columns="3"
                         Margin="0,0,0,20">

                <!-- Rarest -->
                <Border Style="{StaticResource StatCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Rarest"
                                   Style="{StaticResource StatLabelTextStyle}"/>

                        <TextBlock x:Name="RarestItemText"
                                   Text="Prisma Stein"
                                   Style="{StaticResource StatValueTextStyle}"/>

                        <TextBlock x:Name="RarestAmountText"
                                   Text="1x"
                                   Style="{StaticResource StatSubTextStyle}"/>
                    </StackPanel>
                </Border>


                <!-- Total -->
                <Border Style="{StaticResource StatCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Total"
                                   Style="{StaticResource StatLabelTextStyle}"/>

                        <TextBlock x:Name="TotalOwnedText"
                                   Text="80"
                                   Style="{StaticResource StatValueTextStyle}"/>

                        <TextBlock Text="Items insgesamt"
                                   Style="{StaticResource StatSubTextStyle}"/>
                    </StackPanel>
                </Border>


                <!-- Most Common -->
                <Border Style="{StaticResource StatCardStyle}"
                        Margin="0">

                    <StackPanel>
                        <TextBlock Text="Most Common"
                                   Style="{StaticResource StatLabelTextStyle}"/>

                        <TextBlock x:Name="MostCommonItemText"
                                   Text="2x4 Stein Rot"
                                   Style="{StaticResource StatValueTextStyle}"/>

                        <TextBlock x:Name="MostCommonAmountText"
                                   Text="12x"
                                   Style="{StaticResource StatSubTextStyle}"/>
                    </StackPanel>
                </Border>
            </UniformGrid>


            <!-- Inventory Overview -->
            <Border Grid.Row="2"
                    Background="#111827"
                    BorderBrush="#8e51ff"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="16">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Inventar"
                               Foreground="White"
                               FontSize="18"
                               FontWeight="Bold"
                               Margin="0,0,0,12"/>

                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">

                        <ItemsControl x:Name="ProfileInventoryControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="80"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Name}"
                                                   Foreground="White"
                                                   FontSize="14"/>

                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Amount}"
                                                   Foreground="#A78BFA"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Right"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>


        <!-- Bauteile View -->
        <Grid x:Name="BauteileView"
              Grid.Column="1"
              Visibility="Collapsed"
              Margin="25">

            <Border Background="Transparent"
                    BorderBrush="#8e51ff"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="16">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Table Header -->
                    <Grid Grid.Row="0"
                          Margin="0,0,0,10">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="160"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="Bauteil"
                                   FontWeight="Bold"
                                   Foreground="#D1D5DB"
                                   FontSize="16"/>

                        <TextBlock Grid.Column="1"
                                   Text="Anzahl"
                                   Foreground="#D1D5DB"
                                   FontWeight="Bold"
                                   FontSize="16"
                                   HorizontalAlignment="Center"/>
                    </Grid>


                    <!-- Inventory List -->
                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">

                        <ItemsControl x:Name="InventoryItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#E5E7EB"
                                            BorderThickness="0,1,0,0"
                                            Padding="0,10">

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="160"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding Name}"
                                                       FontSize="14"
                                                       Foreground="#D1D5DB"
                                                       VerticalAlignment="Center"/>

                                            <StackPanel Grid.Column="1"
                                                        Orientation="Horizontal"
                                                        HorizontalAlignment="Center">

                                                <Button Content="-"
                                                        Width="28"
                                                        Height="28"
                                                        Click="DecreaseAmount_Click"/>

                                                <TextBlock Text="{Binding Amount}"
                                                           Width="45"
                                                           TextAlignment="Center"
                                                           Foreground="#D1D5DB"
                                                           VerticalAlignment="Center"
                                                           FontSize="14"/>

                                                <Button Content="+"
                                                        Width="28"
                                                        Height="28"
                                                        Click="IncreaseAmount_Click"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>


        <!-- Einstellungen View -->
        <Grid x:Name="EinstellungenView"
              Grid.Column="1"
              Visibility="Collapsed"
              Margin="25">

            <StackPanel>
                <TextBlock Text="Neues scherenteil anlegen"
                           Foreground="White"
                           FontSize="24"
                           FontWeight="Bold"
                           Margin="0,0,0,20"/>

                <TextBlock Text="Name"
                           Foreground="White"/>

                <TextBox x:Name="a"
                         Height="40"
                         Margin="0,5,0,15"/>

                <Button Content="test"
                        Width="120"
                        Height="40"/>
            </StackPanel>
        </Grid>

    </Grid>
</Window>